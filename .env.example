# Postgres (docker compose default)
DATABASE_URL=postgresql+psycopg://regtrace:regtrace@localhost:5432/regtrace

# Optional: if unset, the API uses a deterministic, citation-bound generator
OPENAI_API_KEY=

# Browser-facing API origin used by the Next.js app.
# Leave empty to use the Next.js demo API (same-origin /api) — this is the Vercel default.
# Set to http://localhost:8000 to use FastAPI (local Docker Compose / uvicorn).
NEXT_PUBLIC_API_URL=

# Backend-only
DATA_DIR=../data
CORS_ORIGINS=http://localhost:3000
